first_name": "Noemi", "last_name": "Vergopolan", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 5322269, "full_name": "Alexis Berg", "first_name": "Alexis", "last_name": "Berg", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14488781, "full_name": "Nicholas Lutsko", "first_name": "Nicholas", "last_name": "Lutsko", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 8902742, "full_name": "Ambroise Dufour", "first_name": "Ambroise", "last_name": "Dufour", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 761588, "full_name": "Zhenzhong Zeng", "first_name": "Zhenzhong", "last_name": "Zeng", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 6348, "full_name": "Xin Jiang", "first_name": "Xin", "last_name": "Jiang", "is_active": false, "url_name": "Xin_Jiang", "orcid_id": ""}, {"id": 587468, "full_name": "Albert van Dijk", "first_name": "Albert", "last_name": "van Dijk", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 14488784, "full_name": "Diego Miralles", "first_name": "Diego", "last_name": "Miralles", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/High-resolution_1_km_K_ppen-Geiger_maps_for_1901_2099_based_on_constrained_CMIP6_projections/21789074", "download_disabled": false, "description": "<p dir=\"ltr\">High-resolution maps of the <a href=\"https://en.wikipedia.org/wiki/K\u00f6ppen_climate_classification\" rel=\"noreferrer\" target=\"_blank\">K\u00f6ppen-Geiger</a> climate classification for historical and future climate conditions (Beck et al., 2023).</p><p dir=\"ltr\"><b>IMPORTANT: Most users only need the \"koppen_geiger_tif.zip\" archive (90 MB). It includes GeoTIFFs of K\u00f6ppen-Geiger maps in varying resolutions for multiple periods and future socio-economic scenarios.</b></p><p dir=\"ltr\">For example, the file \"2071_2099\\ssp585\\koppen_geiger_0p01.tif\" in the archive provides the K\u00f6ppen-Geiger map for the period 2071\u20132099 under the SSP5-8.5 scenario with a resolution of 0.01\u00b0 (roughly 1 km). GeoTIFF files are easily viewed using Geographic Information System (GIS) software such as <a href=\"https://qgis.org/\" rel=\"noreferrer\" target=\"_blank\">QGIS</a>.</p><p dir=\"ltr\">The \"koppen_geiger_tif.zip\" archive also contains a legend file, \"legend.txt\", which links the numeric values in the maps to the K\u00f6ppen-Geiger climate symbols and provides the color scheme used for displaying the maps.</p><p dir=\"ltr\">The other archives contain underlying climate data in different resolutions. For details on these archives, please refer to the 'Data Records' section in Beck et al. (2023).</p><p dir=\"ltr\">Please cite Beck et al. (2023) when using the maps in any publication:</p><p dir=\"ltr\">Beck, H. E., T. R. McVicar, N. Vergopolan, A. Berg, N. J. Lutsko, A. Dufour, Z. Zeng, X. Jiang, A. I. J. M. van Dijk, and D. G. Miralles. High-resolution (1 km) K\u00f6ppen-Geiger maps for 1901\u20132099 based on constrained CMIP6 projections. <i>Scientific Data</i> 10, 724 (2023).</p>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 2481020735, "created_date": "2024-03-15T04:38:41Z", "modified_date": "2026-01-14T12:11:24Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["climate change", "K\u00f6ppen", "CMIP6", "vegetation", "high resolution", "species", "biomes", "climatology"], "keywords": ["climate change", "K\u00f6ppen", "CMIP6", "vegetation", "high resolution", "species", "biomes", "climatology"], "categories": [{"id": 25759, "title": "Climatology", "parent_id": 25753, "path": "/25717/25753/25759", "source_id": "370202", "taxonomy_id": 100}, {"id": 29899, "title": "Time series and spatial modelling", "parent_id": 29866, "path": "/29746/2